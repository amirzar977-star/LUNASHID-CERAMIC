import os

from flask import Flask

from database import db
from models import Product
from routes import main_bp, shop_bp


BASE_DIR = os.path.abspath(
    os.path.dirname(__file__)
)

INSTANCE_DIR = os.path.join(
    BASE_DIR,
    "instance"
)

os.makedirs(
    INSTANCE_DIR,
    exist_ok=True
)


app = Flask(__name__)

app.config["SECRET_KEY"] = "lunashid-secret-key"

app.config["SQLALCHEMY_DATABASE_URI"] = (
    "sqlite:///"
    + os.path.join(
        INSTANCE_DIR,
        "lunashid.db"
    )
)

app.config["SQLALCHEMY_TRACK_MODIFICATIONS"] = False


db.init_app(app)


app.register_blueprint(main_bp)
app.register_blueprint(shop_bp)


with app.app_context():

    db.create_all()

    if Product.query.count() == 0:

        products = [

            Product(
                name="گلدان خاکی لونا",
                slug="luna-clay-vase",
                price=850000,
                stock=5,
                category="گلدان",
                description="گلدانی دست‌ساز با فرم طبیعی و بافت گرم خاک.",
                image="images/Hero.jpg",
                featured=True
            ),

            Product(
                name="کاسه دست‌ساز شید",
                slug="shade-handmade-bowl",
                price=620000,
                stock=8,
                category="کاسه",
                description="کاسه‌ای دست‌ساز برای استفاده روزمره و دکور.",
                image="images/Hero.jpg",
                featured=True
            ),

            Product(
                name="ماگ سرامیکی لونا",
                slug="luna-ceramic-mug",
                price=480000,
                stock=12,
                category="ماگ",
                description="ماگ سرامیکی ساده و گرم برای لحظه‌های روزمره.",
                image="images/Hero.jpg",
                featured=True
            ),

            Product(
                name="ظرف دکوراتیو خاک",
                slug="earth-decorative-bowl",
                price=950000,
                stock=3,
                category="ظروف دکوراتیو",
                description="ظرفی دکوراتیو با فرم هنری و ظاهر طبیعی.",
                image="images/Hero.jpg",
                featured=True
            )

        ]

        db.session.add_all(products)

        db.session.commit()


if __name__ == "__main__":

    app.run(
        host="127.0.0.1",
        port=5002,
        debug=True
    )
